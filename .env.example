# Fuzzy Scanner — environment template
# Copy this file to `.env` and fill in your own keys.

# Your Swarms API key from https://swarms.world/platform/api-keys
SWARMS_API_KEY="sk-your-swarms-api-key-here"

# Legacy alias (same value as SWARMS_API_KEY)
fuzzy="sk-your-swarms-api-key-here"

# Optional: override the default LLM model used by agents
# FUZZY_MODEL="gpt-4o"
